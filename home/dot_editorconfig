# ~/.editorconfig: EditorConfig settings (editorconfig.org), which editors such as
# Neovim follow when they save files. A project can have its own .editorconfig:
# editors look for one in the file's folder and in each folder above it, and
# root = true stops that search here, at your home folder.
root = true

# These settings apply to every file ([*] matches any file name).
[*]
# Save text as UTF-8.
charset = utf-8

# Use Unix line endings (LF), rather than Windows' (CRLF).
end_of_line = lf

# End the last line with a line break too.
insert_final_newline = true

# shfmt also reads EditorConfig; it has no separate global config file.
# Keep the existing two-space shell indentation. These options follow shfmt's
# example of Google's shell style: indent case arms and put continued &&/|| first.
# .sh.tmpl covers chezmoi scripts after rendering; raw templates aren't shell code.
[*.{sh,bash,bats,sh.tmpl,bash.tmpl,bats.tmpl}]
indent_style = space
indent_size = 2
binary_next_line = true
switch_case_indent = true
