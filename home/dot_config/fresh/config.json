// Fresh's settings. Fresh (fresh, or the ww alias) is the terminal text editor,
// with familiar keys (Ctrl-S saves, Ctrl-Q quits) and mouse support. Anything
// not listed here keeps Fresh's default.
//
// This file is JSONC: JSON that may also hold // comments and trailing commas.
// Fresh's Settings screen saves changes back into this file, so copy a change
// you want to keep into the dotfiles source too, or chezmoi will undo it.
{
  // Catppuccin Mocha. chezmoi downloads the theme into themes/ via
  // .chezmoiexternal.toml. Fresh's theme picker names it by its file name.
  "theme": "catppuccin-mocha.json",

  // Homebrew upgrades Fresh, so skip its own daily update check (which also
  // sends anonymous usage data).
  "check_for_updates": false,

  // The version of this file's layout. Fresh writes it itself; leave it as is.
  "version": 2,

  // Use VS Code's key bindings (Fresh's default on a Mac is its macOS map).
  "active_keybinding_map": "vscode",

  // How the editor looks and behaves.
  "editor": {
    // Nerd Font icons in the file explorer and menus. Ghostty bundles the
    // symbols; another terminal (such as over SSH) needs a Nerd Font, or the
    // icons show as boxes.
    "nerd_font_icons": true,

    // Hide the File/Edit/View menu bar for one more line of text. The command
    // palette still reaches every command.
    "show_menu_bar": false,

    // Show code completions while typing, as VS Code does, instead of only on
    // Ctrl-Space. It needs a language server for the file's language.
    "completion_popup_auto_show": true,
  },

  // Fresh's built-in plugins, and their settings.
  "plugins": {
    // The welcome screen, shown when Fresh starts without a file.
    "welcome_screen": {
      "enabled": true,
      "settings": {
        "showOnStartup": true,
      },
    },

    // Vim-style editing, available but off until you turn it on in Fresh
    // (autoStart false). Arrow keys still move the cursor, and * / # search
    // for the word under the cursor.
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": true,
      },
    },
  },
}
