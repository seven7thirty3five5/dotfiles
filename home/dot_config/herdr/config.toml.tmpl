{{- /* A template only for fish's full path, in Homebrew's folder. */ -}}
{{- $fish := joinPath (includeTemplate "brew-prefix" . | trim) "bin/fish" -}}

# herdr's settings. herdr runs AI coding agents (and shells) side by side in one
# terminal, like tmux, and shows which of them are working or waiting for you.
# `herdr --default-config` prints every setting with its explanation.

# Skip the first-run setup of notifications.
onboarding = false

# catppuccin is also herdr's default theme.
[theme]
name = "catppuccin"

# Every new pane runs fish, which holds your shell setup (~/.config/fish).
# herdr would otherwise use $SHELL, the login shell you start herdr from, which
# these dotfiles leave alone. The full path is needed because herdr can start
# without Homebrew on PATH: from that login shell, or over SSH (`herdr
# --remote`, saved machines).
# shell_mode keeps its default: login shells on macOS, non-login elsewhere.
[terminal]
default_shell = {{ $fish | quote }}

[update]
# Homebrew upgrades herdr; skip the background check of herdr.dev.
version_check = false

# Show each agent's state (blocked, working, done, idle) as a distinct symbol
# rather than a colored dot.
[ui]
status_indicators = "symbols"

# Desktop notification (via Ghostty's OSC 9 support) when a background agent finishes or
# needs input; "terminal" also works through SSH. Sounds stay on, as by default.
[ui.toast]
delivery = "terminal"

# The prefix key: press Ctrl+Space, then another key, to give herdr a command.
# (herdr's default is Ctrl+B, like tmux's.)
[keys]
prefix = "ctrl+space"

# The popups below run through fish (`fish -c COMMAND`). herdr starts popup
# commands with its own environment, which only has what the login shell set
# up; fish adds Homebrew and the rest, as in a pane. Without it, lazygit on
# macOS wouldn't see XDG_CONFIG_HOME and would read its settings from
# ~/Library/Application Support/lazygit instead of ~/.config/lazygit. herdr
# runs the command with /bin/sh -c; exec replaces that sh with fish.

# Lazygit in a popup over the current pane (the example in herdr --default-config).
# Press the prefix, then Alt+G.
[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = {{ printf "exec %s -c lazygit" ($fish | shellQuote) | quote }}
width = "80%"
height = "80%"

# GitHub's PRs, issues and notifications in a gh dash popup.
# Press the prefix, then Alt+H.
[[keys.command]]
key = "prefix+alt+h"
type = "popup"
command = {{ printf "exec %s -c %s" ($fish | shellQuote) ("gh dash" | shellQuote) | quote }}
width = "80%"
height = "80%"
