# Packages for the tools configured by these dotfiles and companion CLI utilities.
# install.sh and `chezmoi apply` install them (home/.chezmoiscripts) and re-run
# `brew bundle` whenever this file changes.

# Dotfile management.
brew "chezmoi"

# Interactive shell.
brew "atuin"
brew "eza"
brew "fzf"
brew "starship"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Git and GitHub. gh-dash is a gh extension; a chezmoi script installs it.
brew "git"
brew "git-delta"
brew "difftastic"
brew "gh"
brew "lazygit"

# Neovim and search. A chezmoi script installs LazyVim's plugins from lazy-lock.json.
brew "neovim"
brew "ast-grep"
brew "fd"
brew "ripgrep"

# Terminal utilities.
brew "bat"
brew "btop"
brew "duf"
brew "dust"
brew "glow"
brew "herdr"
brew "hyperfine"
brew "lazydocker"
brew "superfile"
brew "yq"

# Mason needs GNU tar; Linux supplies it through the system package manager.
brew "gnu-tar" if OS.mac?

# Mole is macOS-only.
brew "mole" if OS.mac?

# Terminal (macOS). Ghostty bundles JetBrains Mono and the Nerd Font symbols. brew bundle
# installs casks with --adopt, so an existing /Applications/Ghostty.app is taken over.
cask "ghostty" if OS.mac?
