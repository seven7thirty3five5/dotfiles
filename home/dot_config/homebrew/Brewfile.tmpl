{{- /*
  Written to ~/.config/homebrew/Brewfile, and into the install-packages script,
  which runs `brew bundle` with it. The part at the end is macOS-only.
*/ -}}

# Homebrew's packages for these dotfiles: each brew line is a command-line tool
# (a formula), each cask line an app. chezmoi and mise live in ~/.local/bin
# instead, and the login shell is the system's own; fish runs in herdr's panes.

# Interactive shell plugins and tools.
brew "fish"       # the shell in herdr's panes (~/.config/fish)
brew "atuin"      # shell history in a searchable database (Ctrl-R)
brew "eza"        # a modern ls, with colors, icons and git status
brew "fzf"        # fuzzy finder: pick from a list by typing part of an entry
brew "starship"   # the prompt (the text before your cursor)
brew "zoxide"     # cd jumps to folders you use often, by part of their name

# Git and GitHub. gh-dash is a gh extension; a chezmoi script installs it.
brew "git"                      # a newer git than the system's
brew "git-delta"                # delta: diffs with syntax highlighting and line numbers
brew "difftastic"               # difft: diffs that compare code by its structure
brew "gh"                       # GitHub's command-line tool
brew "lazygit"                  # a terminal interface for git (lazygit, or gg)
brew "act"                      # runs GitHub Actions locally in Docker containers
brew "actionlint"               # checks GitHub Actions workflows, including their shell steps

# Shell development. shfmt reads the shell settings in ~/.editorconfig.
brew "shellcheck"               # finds bugs and portability issues in sh and bash scripts
brew "shfmt"                    # formats sh and bash scripts consistently

# Editors and search. Both editors get their themes from .chezmoiexternal.toml.
brew "fresh-editor"             # alternative editor (fresh), with familiar keys and a mouse
brew "micro"                    # default editor, with familiar keys and a mouse
brew "ast-grep"                 # searches and rewrites code by its structure
brew "fd"                       # a simpler, faster find
brew "ripgrep"                  # rg: fast search through file contents

# Terminal utilities.
brew "bat"                      # cat with syntax highlighting
brew "btop"                     # live view of CPU, memory, disks, network and processes
brew "duf"                      # free space on each disk (a friendlier df)
brew "dust"                     # which folders use the most space (a friendlier du)
brew "glow"                     # shows Markdown files nicely in the terminal
brew "herdr"                    # runs AI coding agents side by side in one terminal
brew "hyperfine"                # times commands precisely (benchmarks)
brew "jq"                       # selects, transforms and formats JSON data
brew "lazydocker"               # a terminal interface for Docker (lazydocker, or dd)
brew "yazi"                     # a file manager in the terminal (yazi, or ff)
brew "yq"                       # reads and edits YAML, JSON and other data files

# Yazi optional dependencies. jq, fd, ripgrep, fzf and zoxide are listed above.
brew "ffmpeg"                   # video thumbnails
brew "sevenzip"                 # archive previews and extraction
brew "poppler"                  # PDF previews
brew "resvg"                    # SVG previews
brew "imagemagick"              # font and image previews

# AI coding agents. These casks are command-line tools and also install on
# Linux. herdr's integrations hook into both; `update` installs them.
cask "claude-code"              # claude: Anthropic's coding agent
cask "codex"                    # codex: OpenAI's coding agent
{{- if eq .chezmoi.os "darwin" }}

# Mole is macOS-only.
brew "mole"                     # mo: cleans caches and leftovers to free space on a Mac

# Terminal (macOS). Ghostty bundles JetBrains Mono and the Nerd Font symbols.
# brew bundle adopts existing app bundles, keeping their settings.
cask "ghostty"

# AI tool usage (macOS). CodexBar shows usage and limits in the menu bar.
cask "codexbar"

# System, window and display utilities (macOS).
cask "stats"                    # system statistics in the menu bar
cask "rectangle"                # window positioning and sizing shortcuts
cask "betterdisplay"            # display resolution, scaling and brightness controls

# Docker Desktop writes links in /usr/local, and Logi Options+ runs a privileged
# installer, so both ask for your password.
cask "docker-desktop"
cask "logi-options+"
{{- end }}
