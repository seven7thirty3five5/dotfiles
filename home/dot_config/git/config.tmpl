{{- /*
  git's settings for your user; git reads them from ~/.config/git/config. It's a
  template: your name and email come from your answers to chezmoi's setup
  questions, and the delta settings are only written where Homebrew installed
  delta. `git help config` explains every setting.
*/ -}}

{{- $brewPrefix := includeTemplate "brew-prefix" . | trim -}}

# Who you are: git records this name and email as the author of your commits.
[user]
    name = {{ .gitName | quote }}
    email = {{ .gitEmail | quote }}

{{ if and $brewPrefix (isExecutable (joinPath $brewPrefix "bin" "delta")) -}}
# delta only where Homebrew installed it; elsewhere git keeps its default pager (less).
# (A pager shows long output one screen at a time. delta also colors diffs, with
# syntax highlighting and line numbers.)
[core]
    pager = delta

# `git add -p` shows each change through delta too. --color-only keeps the lines
# exactly where git put them, which git needs there.
[interactive]
    diffFilter = delta --color-only

{{ end -}}

# Read more settings from another file: the Catppuccin theme for delta.
[include]
    path = ~/.config/delta/themes/catppuccin.gitconfig  # fetched via .chezmoiexternal.toml

# delta's own settings. syntax-theme sets the colors for the code itself.
[delta]
    features = catppuccin-mocha  # Catppuccin's delta theme: diff, header, line-number colors
    navigate = true  # use n and N to move between diff sections
    dark = true      # or `light = true`, or omit for auto-detection
    syntax-theme = Catppuccin Mocha
    line-numbers = true

# In a merge conflict, also show the original version both sides started from.
# (diff3 works with every git. Its tidier variant, zdiff3, needs git 2.35 or
# newer, and older gits refuse to run checkout, switch or rebase at all when
# they see it, for example Ubuntu 22.04's system git.)
[merge]
    conflictStyle = diff3

[init]
    defaultBranch = main         # new repos start on main instead of master

[column]
    ui = auto                    # list branches and tags in columns when they fit

[branch]
    sort = -committerdate        # most recently committed branches first

[tag]
    sort = version:refname       # v1.10 sorts after v1.9 instead of after v1.1

[push]
    autoSetupRemote = true       # first push of a new branch sets its upstream
    followTags = true            # also push annotated tags that point at pushed commits

[pull]
    rebase = true                # replay local commits instead of merge commits

[fetch]
    prune = true                 # drop local copies of branches deleted on the remote
    pruneTags = true             # likewise drop local tags deleted on the remote
    all = true                   # fetch every remote (e.g. origin and upstream), not one

[rebase]
    autoSquash = true            # fixup!/squash! commits move into place in rebase -i
    autoStash = true             # stash uncommitted changes before a rebase, pop after
    updateRefs = true            # branches stacked on the rebased one move with it

[rerere]
    enabled = true               # remember conflict resolutions and reuse them
    autoupdate = true            # stage files once rerere has resolved them

[commit]
    verbose = true               # show the diff below the message while you write it

[help]
    autocorrect = prompt         # on a typo, offer to run the closest git command

# Structural diffs are opt-in; regular git diff remains a text diff via delta.
# difftastic (the difft command) compares code by its structure instead of line by
# line, which shows moved or reformatted code more clearly. `git difftool` uses it.
[diff]
    tool = difftastic
    colorMoved = default         # moved lines get their own colors
    algorithm = histogram        # cleaner hunks when code is moved or reordered

# How `git difftool` runs difft. It passes git's longer "external diff" format,
# as difftastic's manual shows, so difft can show the file's real name ($MERGED)
# rather than the names of the temporary copies it compares ($LOCAL, $REMOTE).
# The commit hashes and file modes in that format are placeholders.
[difftool "difftastic"]
    cmd = difft \"$MERGED\" \"$LOCAL\" abcdef1 100644 \"$REMOTE\" abcdef2 100644

# Don't ask before showing each file.
[difftool]
    prompt = false

# Show difftool's output one screen at a time, like git diff's.
[pager]
    difftool = true

# Structural diffs for commit history, individual commits, and working-tree changes.
# git dlog, git dshow and git ddiff run log, show and diff with difft doing the
# diffing, just for that command (-c sets a setting for one command only).
[alias]
    dlog = -c diff.external=difft log -p --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff
