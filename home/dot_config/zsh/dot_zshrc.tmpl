{{- /*
  .zshrc: zsh runs this for interactive shells, the ones you type commands into.
  It sets up aliases, history, tab completion, key bindings and the prompt. It's
  a template: chezmoi fills in the Homebrew parts for this machine.
*/ -}}

{{- $brewPrefix := includeTemplate "brew-prefix" . | trim -}}

# How to read this file:
#   (( $+commands[eza] ))  "is eza installed?" Settings for optional tools are
#                          skipped when the tool is missing.
#   alias l="eza ..."      typing l runs that command instead.
#   name() { ...; }        defines a function: a small command of your own.
#   setopt NAME            turns on one of zsh's options (see man zshoptions).
#   zstyle ...             configures zsh's tab completion.
#   bindkey KEYS ACTION    makes a key run an editing action. KEYS are what the
#                          terminal sends for the key: ^[ is Escape, ^P is Ctrl-P.
#   eval "$(tool init zsh)"  runs the setup code that a tool prints for zsh.

# Interactive setup only.
# (zsh only reads .zshrc for interactive shells anyway; this also stops it when
# a script runs `source .zshrc`.)
[[ -o interactive ]] || return

{{ if and (eq .chezmoi.os "linux") $brewPrefix -}}
# Homebrew shell initialization belongs to interactive shells on Linux.
# (That's where Homebrew's installer puts it on Linux; macOS uses .zprofile.)
eval "$({{ joinPath $brewPrefix "bin" "brew" | shellQuote }} shellenv zsh)"

# Refresh the shared environment so ~/.local/bin stays ahead of Homebrew, as on macOS.
[[ -f "$ZDOTDIR/.zshenv" ]] && source "$ZDOTDIR/.zshenv"

{{ end -}}

# Default aliases and functions, only for programs that are installed.
if (( $+commands[nvim] )); then
  alias vi="nvim"   # Open Neovim when invoking vi.
  alias vim="nvim"  # Open Neovim when invoking vim.
fi

# Open superfile and change to its last directory on exit.
(( $+commands[spf] )) && alias ff="spf"

# spf (and ff): superfile, then cd to the folder you were in when you quit it (superfile docs,
# "cd on quit"; needs cd_on_quit = true). spf pl --lastdir-file prints where superfile writes
# that folder: the XDG state dir here, not the ~/Library path in the docs' macOS snippet.
# `command spf` runs the spf program itself, not this function; source runs the cd
# command that superfile wrote to that file.
if (( $+commands[spf] )); then
  spf() {
    local lastdir_file="$(command spf pl --lastdir-file)"
    command spf "$@"
    if [[ -f $lastdir_file ]]; then
      source "$lastdir_file"
      rm -f -- "$lastdir_file"
    fi
  }
fi

# Open LazyGit's interactive Git interface (the alias suggested in its README).
(( $+commands[lazygit] )) && alias lg='lazygit'

# eza listings; plain ls keeps its usual flags (ls -ltr etc.). Folders first, icons, and
# a git status column in long views, as Oh My Zsh's eza plugin options do.
if (( $+commands[eza] )); then
  # List all files in detail with a header, icons, and Git status; folders first.
  alias l="eza -lah --group-directories-first --icons=auto --git"

  # List visible files in detail with icons and Git status; folders first.
  alias ll="eza -l --group-directories-first --icons=auto --git"

  # Include hidden files in the detailed listing with icons and Git status.
  alias la="eza -la --group-directories-first --icons=auto --git"

  # Show a directory tree two levels deep, with folders first and icons.
  alias lt="eza --tree --level=2 --group-directories-first --icons=auto"

  # Show repository status for listed directories, useful from ~/Projects.
  alias lrepos='eza -l --git-repos --group-directories-first --icons=auto'
fi

# Core Git shortcuts and worktree aliases follow Oh My Zsh's git plugin.
if (( $+commands[git] )); then
  alias g='git'                       # Run Git.
  alias ga='git add'                  # Stage the specified paths.
  alias gaa='git add --all'           # Stage all changes, including additions and deletions.
  alias gb='git branch'               # List branches, or manage them with additional arguments.
  alias gc='git commit --verbose'     # Commit staged changes with their diff shown in the editor.
  alias gca='git commit --verbose --all'  # Stage tracked-file changes and commit with a diff in the editor.
  alias gco='git checkout'            # Check out a branch or restore specified paths.
  alias gcb='git checkout -b'         # Create a branch and check it out.
  alias gd='git diff'                 # Show unstaged changes relative to the index.
  alias gds='git diff --staged'       # Show staged changes for the next commit.
  alias gl='git pull'                 # Fetch and integrate upstream changes using your rebase policy.
  alias glog='git log --oneline --decorate --graph'        # Show a compact commit graph with branch and tag labels.
  alias gloga='git log --oneline --decorate --graph --all'  # Show the compact graph across all branches and tags.
  alias gp='git push'                 # Push commits to the configured remote.
  alias gpf='git push --force-with-lease --force-if-includes'  # Push rewritten history with Git's lease and inclusion checks.
  alias grb='git rebase'              # Replay commits onto another base.
  alias grbi='git rebase --interactive'  # Interactively reorder, edit, or squash commits, including fixup commits.
  alias gst='git status'              # Show working-tree and staging-area status.
  alias gsta='git stash push'         # Temporarily save tracked-file changes in a stash.
  alias gstp='git stash pop'          # Restore the latest stash and remove it after a successful application.
  alias gsw='git switch'              # Switch to an existing branch.
  alias gswc='git switch --create'    # Create a branch and switch to it.
  alias gwta='git worktree add'       # Create another checkout; pass -b NAME to create its branch.
  alias gwtls='git worktree list'     # List worktree directories and their checked-out branches.
  alias gfixup='git commit --fixup'   # Commit staged corrections for a specified commit; autosquash folds them in later.
fi

if (( $+commands[git] && $+commands[delta] )); then
  # Show a side-by-side diff; append --staged to review staged changes.
  alias gdiffsplit='git -c delta.side-by-side=true diff'
fi

# help <command>: colorized --help output (bat README), e.g. help git commit.
# help() calls bat directly because zsh parses this whole if-block before the alias exists.
# ("$@" stands for all the words after help; 2>&1 includes error output, where some
# programs print their help.)
if (( $+commands[bat] )); then
  alias bathelp='bat --plain --language=help'  # Highlight piped help text without headers or line numbers.
  alias bcat='bat --plain --paging=never'      # Print highlighted file contents without decorations or a pager.
  help() { "$@" --help 2>&1 | bat --plain --language=help; }
fi

# Inspect dotfile changes before applying them (chezmoi's daily workflow).
if (( $+commands[chezmoi] )); then
  alias czs='chezmoi status'  # Show which managed dotfiles differ from their desired state.
  alias czd='chezmoi diff'    # Preview the changes chezmoi would apply to managed dotfiles.
fi

if (( $+commands[fd] )); then
  alias fdall='fd --hidden --no-ignore --exclude .git'  # Find hidden and ignored files, excluding .git directories.
fi

if (( $+commands[rg] )); then
  alias rgall='rg --no-ignore'  # Search ignored files too, retaining your hidden-file and .git settings.
fi

if (( $+commands[duf] )); then
  alias dfh='duf --only local'  # Show capacity and usage for local filesystems.
fi

if (( $+commands[dust] )); then
  alias du2='dust --depth 2'  # Show a directory-size tree limited to two levels.
fi

if (( $+commands[hyperfine] )); then
  alias bench='hyperfine --warmup 3'  # Benchmark steady-state performance after three warm-up runs.
fi

if (( $+commands[yq] )); then
  alias y2j='yq -o=json'              # Read YAML and emit JSON.
  alias j2y='yq -p=json -o=yaml -P'   # Read JSON and emit formatted YAML.
fi

# rge PATTERN [PATH...]: select a content match, preview it, and open its line in Neovim.
# Adapted from github.com/junegunn/fzf/blob/master/ADVANCED.md (ripgrep integration).
# Colon-separated results assume filenames do not contain colons.
# rg prints file:line:text for each match. fzf lists them, keeping rg's colors
# (--ansi); searches only the text, from the third :-separated field on; quits when
# there are no matches (--exit-0); previews the file with bat, highlighting the
# line; and on Enter turns into nvim, opened at that line.
if (( $+commands[rg] && $+commands[fzf] && $+commands[bat] && $+commands[nvim] )); then
  rge() {
    rg --line-number --no-heading --color=always -- "$@" |
      fzf --ansi --delimiter ':' --nth '3..' --exit-0 \
        --preview 'bat --color=always --highlight-line {2} -- {1}' \
        --bind 'enter:become(nvim +{2} -- {1})'
  }
fi

# Command history, kept in ~/.local/state/zsh/history: up to 10,000 commands in
# memory (HISTSIZE) and in the file (SAVEHIST). mkdir -p creates the folders for
# it and for zsh's caches if they're missing.
mkdir -p -- "$XDG_STATE_HOME/zsh" "$XDG_CACHE_HOME/zsh"
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=10000
SAVEHIST=10000

# Atuin keeps the full chronological record; zsh's list is a deduped recall list.
setopt EXTENDED_HISTORY       # save timestamp and duration
setopt SHARE_HISTORY          # all shells read/write one history file
setopt HIST_IGNORE_ALL_DUPS   # re-running a command drops its older copy
setopt HIST_IGNORE_SPACE      # leading space = don't save (atuin agrees)
setopt HIST_REDUCE_BLANKS     # collapse extra whitespace before saving
setopt HIST_VERIFY            # show !!/!$ expansions for review before running

# General shell behavior.
setopt INTERACTIVE_COMMENTS   # allow '# comment' at the prompt
setopt LONG_LIST_JOBS         # job notices include the PID
setopt NO_FLOW_CONTROL        # free Ctrl-S/Ctrl-Q from terminal freeze/resume
setopt AUTO_CD                # type a directory's path (e.g. ..) to cd into it
setopt AUTO_PUSHD             # cd pushes onto the dir stack (dirs -v, cd -N)
setopt PUSHD_IGNORE_DUPS      # keep each directory once on the stack
setopt PUSHD_MINUS            # cd -N matches dirs -v numbering

# WORDCHARS lists the symbols that count as part of a word when you delete or move
# by word; ${WORDCHARS//\/} is that list with / removed.
WORDCHARS=${WORDCHARS//\/}    # Ctrl-W / Alt-B stop at '/'

# Directory stack shortcuts: d lists recent directories, 1-9 jump to one of them,
# - returns to the previous one; ... and .... go up two and three levels (AUTO_CD).
alias d='dirs -v | head -n 10'  # List the first ten directory-stack entries with their numbers.

# Each generated alias 1-9 changes to the directory with that stack number.
for i in {1..9}; do alias "$i"="cd -$i"; done; unset i

alias -- -='cd -'          # Return to the previous working directory.
alias ...='../..'          # Go up two directory levels using AUTO_CD.
alias ....='../../..'      # Go up three directory levels using AUTO_CD.

# Tab completion. fpath is the list of folders where zsh finds functions, including
# the completion functions that know each command's options.
# Keep fpath entries unique, so re-adding a folder that's already listed is harmless.
typeset -U fpath

{{ if $brewPrefix -}}
# Homebrew's completion folder. On macOS, .zprofile's brew shellenv adds it in
# login shells (every terminal tab), and shells started from those inherit it via
# FPATH. This line covers a non-login zsh started outside a terminal (e.g. by an
# app opened from the Dock), which gets neither.
fpath=({{ joinPath $brewPrefix "share/zsh/site-functions" | shellQuote }} $fpath)

{{ end -}}

# Docker Desktop's completions (its own setup lines go to ~/.zshrc, which zsh never reads here).
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

# Completions that don't come from Homebrew, such as chezmoi's (install.sh puts
# chezmoi in ~/.local/bin, and chezmoi writes its own completion file here).
# Another tool's can go here too, e.g.
# `some-tool completion zsh > "$ZDOTDIR/completions/_some-tool"`.
fpath=("$ZDOTDIR/completions" $fpath)

zmodload zsh/complist          # menu selection; must load before compinit

# autoload -Uz loads a function from fpath the first time it's used. compinit turns
# tab completion on; -d says where to save its index of completion functions (the
# "dump"), which makes later shells start faster. There is one per zsh version,
# because a dump made by a different version may not work.
autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

# Let tools that only ship bash completions (complete -C ...; e.g. aws, terraform) work.
autoload -Uz bashcompinit && bashcompinit

# Completion menu, smart-case then substring matching, grouped results.
# Alternative: fzf-tab (github.com/Aloxaf/fzf-tab) swaps this menu for an fzf
# picker. Source it after compinit and before autosuggestions/highlighting,
# then set `menu no` and a plain descriptions format ('[%d]'; it ignores %F
# colors). matcher-list, group-name, and the cache styles stay useful; complist
# and the Shift-Tab binding become unnecessary.
setopt COMPLETE_IN_WORD        # complete at the cursor, not only at word end
setopt ALWAYS_TO_END           # then move the cursor to the end of the word

# Show matches in a menu you can move through with Tab and the arrow keys.
zstyle ':completion:*' menu select

# How typed text matches, tried in order until one finds something: exactly; then
# with lowercase letters also matching uppercase ones; then anywhere in the name.
zstyle ':completion:*' matcher-list '' 'm:{[:lower:]}={[:upper:]}' 'l:|=* r:|=*'

# Group matches by kind (files, options, ...), each under a yellow heading.
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# Cache the results of slow completions.
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"

# Color menu entries by file type using zsh's built-in defaults (LS_COLORS is
# unset; eza uses its own theme). Alternative: brew install vivid, then
#   export LS_COLORS="$(vivid generate catppuccin-mocha)"
#   zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# for Catppuccin colors here; check eza afterwards, since it also reads LS_COLORS.
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' special-dirs true   # also complete . and .. (cd ..<Tab> -> ../)

# Use Emacs editing even when EDITOR or VISUAL is nvim/vim.
# (zsh would pick Vim-style editing by itself, because EDITOR contains "vi". Emacs
# style means keys such as Ctrl-A for start of line, Ctrl-E for end, Ctrl-W to
# delete a word.)
bindkey -e

# Up/Down and Ctrl-P/N: search history for lines starting with what's typed.
# Both arrow sequences cover normal and application cursor modes.
# Alternative: drop --disable-up-arrow from atuin init and delete these
# bindings; Up then opens atuin's picker prefilled with the typed text
# (tune via search_mode/filter_mode_shell_up_key_binding in atuin config).
# (zle -N makes a function available as an editing action for bindkey.)
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^P'   up-line-or-beginning-search
bindkey '^N'   down-line-or-beginning-search

# Keys emacs mode leaves unbound.
bindkey '^[[H'    beginning-of-line    # Home
bindkey '^[OH'    beginning-of-line
bindkey '^[[1~'   beginning-of-line    # Home/End as VT220-style terminals send them
bindkey '^[[7~'   beginning-of-line
bindkey '^[[F'    end-of-line          # End
bindkey '^[OF'    end-of-line
bindkey '^[[4~'   end-of-line          # Home/End as rxvt-style terminals send them
bindkey '^[[8~'   end-of-line
bindkey '^[[5~'   up-line-or-history    # Page Up: previous history entry
bindkey '^[[6~'   down-line-or-history  # Page Down: next history entry
bindkey '^[[3~'   delete-char          # Delete (fn-Backspace on a Mac)
bindkey '^[[3;5~' kill-word            # Ctrl-Delete: delete the word ahead
bindkey '^[[1;5C' forward-word         # Ctrl-Right
bindkey '^[[1;5D' backward-word        # Ctrl-Left
bindkey '^[[1;3C' forward-word         # Alt/Option-Right
bindkey '^[[1;3D' backward-word        # Alt/Option-Left
bindkey ' '       magic-space          # expand !!/!$ on space
bindkey '^[[Z'    reverse-menu-complete  # Shift-Tab: back through the menu

# Ctrl-X Ctrl-E: edit the current command line in $EDITOR.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E'    edit-command-line

# Escape ?, &, * etc. in URLs as they're typed or pasted, so commands like
# curl https://x/?a=b&c=d work unquoted. Must precede the plugins, which wrap widgets.
autoload -Uz url-quote-magic bracketed-paste-magic
zle -N self-insert url-quote-magic
zle -N bracketed-paste bracketed-paste-magic

# Atuin owns Ctrl-R; fzf keeps its default file/directory selection.
# List candidates with fd so fzf respects .gitignore (fzf README, "Respecting .gitignore").
if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'
  _fzf_compgen_path() { fd --hidden --follow --exclude .git . "$1"; }          # vim **<Tab>
  _fzf_compgen_dir() { fd --type d --hidden --follow --exclude .git . "$1"; }  # cd **<Tab>
fi

# Previews from fzf's README: Ctrl-T shows the file (Ctrl-/ moves or hides the preview).
(( $+commands[bat] )) && export FZF_CTRL_T_OPTS="
  --walker-skip .git,node_modules,target
  --preview 'bat -n --color=always {}'
  --bind 'ctrl-/:change-preview-window(down|hidden|)'"

# Ctrl-O opens selected files in Neovim, then returns to fzf.
if (( $+commands[fzf] && $+commands[nvim] )); then
  export FZF_CTRL_T_OPTS="$FZF_CTRL_T_OPTS --bind 'ctrl-o:execute(nvim -- {+})'"
fi

# Alt-C shows the directory tree (also from fzf's README).
(( $+commands[eza] )) && export FZF_ALT_C_OPTS="
  --walker-skip .git,node_modules,target
  --preview 'eza --tree --level=2 --color=always {} | head -200'"

# Load fzf's key bindings (Ctrl-T, Alt-C) and its ** completion: fzf --zsh prints
# them, and source <(...) runs that output. The empty FZF_CTRL_R_COMMAND= tells
# fzf to leave Ctrl-R to atuin.
(( $+commands[fzf] )) && FZF_CTRL_R_COMMAND= source <(fzf --zsh)

# Autosuggestion sources: atuin init puts its history first; zsh history and Tab
# completion are fallbacks (completion suggests e.g. branch or file names never typed).
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Look up suggestions only while the line is short (the README's recommended value),
# so large pastes don't run the slow completion strategy.
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

# Suggestion text uses Catppuccin Mocha's Overlay1 color.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#7f849c'

# Start the tools that hook into the shell:
#   atuin     searchable history on Ctrl-R. --disable-up-arrow leaves the Up arrow
#             to the history search bound above, and --disable-ai leaves ? alone
#             instead of binding it to Atuin AI.
#   zoxide    --cmd cd makes cd smarter: cd with part of a folder's name jumps to
#             the matching folder you use most.
#   starship  draws the prompt.
(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh --cmd cd)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Open LazyDocker's interactive Docker interface. Like lazygit, it reads its
# settings from $XDG_CONFIG_HOME (~/.config/lazydocker/config.yml).
(( $+commands[lazydocker] )) && alias lzd='lazydocker'

# Machine-specific settings (not tracked by chezmoi), loaded last so they can
# override the defaults above and use compdef; the plugins below must still follow.
[[ -f "$ZDOTDIR/.zshrc.local" ]] && source "$ZDOTDIR/.zshrc.local"

{{ if $brewPrefix -}}
# Homebrew zsh plugins. Autosuggestions wraps widgets created above.
# zsh-autosuggestions shows a grey suggestion as you type (the Right arrow accepts
# it); zsh-syntax-highlighting colors the command line as you type it. Each line
# below loads one file, if it exists.
# Syntax highlighting goes last; its Catppuccin theme (fetched via .chezmoiexternal.toml) must load before it.
[[ -f {{ joinPath $brewPrefix "share/zsh-autosuggestions/zsh-autosuggestions.zsh" | shellQuote }} ]] && source {{ joinPath $brewPrefix "share/zsh-autosuggestions/zsh-autosuggestions.zsh" | shellQuote }}
[[ -f "$ZDOTDIR/themes/catppuccin_mocha-zsh-syntax-highlighting.zsh" ]] && source "$ZDOTDIR/themes/catppuccin_mocha-zsh-syntax-highlighting.zsh"
[[ -f {{ joinPath $brewPrefix "share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" | shellQuote }} ]] && source {{ joinPath $brewPrefix "share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" | shellQuote }}

# Also color matching (), [], {} pairs by nesting depth; appended after the plugin sets its defaults.
ZSH_HIGHLIGHT_HIGHLIGHTERS+=(brackets)
{{ end -}}
