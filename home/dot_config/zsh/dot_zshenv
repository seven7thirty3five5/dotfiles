# ~/.config/zsh/.zshenv: the environment every zsh gets, including scripts and
# SSH commands. ~/.zshenv runs this file first thing, and on macOS .zprofile
# (on Linux, .zshrc) runs it again after setting up Homebrew.
#
# ~/.zshenv and this file should NEVER output anything: they run in scripts and
# SSH commands too, where startup output can corrupt data or transfer protocols.
# Keep this file idempotent so macOS .zprofile can source it after path_helper.
# (Idempotent: running it twice has the same effect as running it once.)

# Where XDG programs look for system-wide settings and data, unless already set.
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# XDG_RUNTIME_DIR belongs to the OS/session; do not invent a persistent path.

# Ubuntu's zsh (/usr/bin/zsh, the login shell these dotfiles set up there)
# reads /etc/zsh/zshrc, which runs its own compinit (the tab completion setup)
# unless this is set. .zshrc runs ours, which keeps its cache in ~/.cache/zsh
# instead of leaving a .zcompdump file in your home folder.
skip_global_compinit=1

# Unique entries make repeated sourcing safe; restore the same PATH priorities.
# In zsh, $path is the PATH variable as a list: changing one changes the other.
# typeset -U keeps only the first copy of each folder in it, so putting
# ~/.local/bin (your own programs) first also moves it back in front of
# Homebrew's folders when this file runs again after Homebrew's setup.
typeset -U path
path=("$HOME/.local/bin" $path)

# Docker Desktop's command-line tools, if it's installed (-d: the folder exists;
# += adds to the end of the list).
[[ -d "$HOME/.docker/bin" ]] && path+=("$HOME/.docker/bin")
export PATH

# Explicit overrides for tools whose defaults may bypass XDG on macOS.
# Each one tells a program where its files are: bat's and eza's config folders
# (eza's holds its theme), ripgrep's config file (rg reads none unless this is
# set), Starship's config file, and the folder for zoxide's list of folders.
export BAT_CONFIG_DIR="$XDG_CONFIG_HOME/bat"
export EZA_CONFIG_DIR="$XDG_CONFIG_HOME/eza"
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/config.toml"
export _ZO_DATA_DIR="$XDG_DATA_HOME/zoxide"

# Programs that show long output one screen at a time use less; -R lets less
# show colors instead of raw color codes.
export PAGER="less"
export LESS="-R"

# The editor that programs open for you, such as git for commit messages: nvim
# when it's installed, otherwise vi. $+commands[nvim] is 1 if nvim is on PATH,
# and `A && B || C` runs B when A succeeds, otherwise C. Some programs read
# EDITOR and others VISUAL, so both are set.
(( $+commands[nvim] )) && export EDITOR="nvim" || export EDITOR="vi"
export VISUAL="$EDITOR"

# Catppuccin Mocha for fzf (from catppuccin/fzf). fzf adds FZF_DEFAULT_OPTS to
# its options every time it runs.
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#6C7086,label:#CDD6F4"
