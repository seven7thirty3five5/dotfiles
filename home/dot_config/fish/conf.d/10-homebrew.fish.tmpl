{{- $brew := joinPath (includeTemplate "brew-prefix" . | trim) "bin/brew" | shellQuote -}}
{{ if not .useSudo -}}
# No sudo on this machine: Homebrew must never ask for a sudo password.
set -gx HOMEBREW_NO_SUDO 1

{{ end -}}
# Homebrew's PATH, MANPATH and HOMEBREW_* variables, once it's installed.
if test -x {{ $brew }}
    {{ $brew }} shellenv fish | source
end
