{{- /*
  The shims line comes from `mise activate fish --shims` when chezmoi applies;
  it's left out until mise is installed in ~/.local/bin.
*/ -}}

{{- $mise := findExecutable "mise" (list (joinPath .chezmoi.homeDir ".local/bin")) -}}

# Runs after 10-homebrew.fish, so these end up in front of Homebrew. --global
# --path changes this shell's PATH rather than the saved fish_user_paths.

# ~/.local/bin (chezmoi and mise) before Homebrew.
fish_add_path --global --move --path $HOME/.local/bin

# Docker Desktop's command-line tools, at the end.
fish_add_path --global --append --path $HOME/.docker/bin
{{- if $mise }}

# mise's shims, so scripts and herdr's popups find the runtimes too.
{{ output $mise "activate" "fish" "--shims" | trim }}
{{- end }}

# Micro when installed, else vi; set once PATH is final. Some programs read
# VISUAL instead of EDITOR.
if command -q micro
    set -gx EDITOR micro
else
    set -gx EDITOR vi
end

set -gx VISUAL $EDITOR
