{{- /*
  Shared personal preferences. Omit other preferences so Codex supplies its
  defaults. Preserve machine-local connections, trust, and client bookkeeping
  from the destination without putting their values in the repository. Also
  keep [features], where herdr's Codex integration turns on hooks. herdr also
  rewrites the file in its own formatting; when the contents already match,
  keep the file as it is, so chezmoi has nothing to change or ask about.
*/ -}}
{{- $settings := dict
    "approval_policy" "on-request"
    "approvals_reviewer" "auto_review"
    "sandbox_mode" "workspace-write"
    "model_reasoning_effort" "max"
    "service_tier" "fast"
-}}
{{- $tui := dict
    "theme" "catppuccin-mocha"
    "status_line" (list
        "model-with-reasoning"
        "current-dir"
        "five-hour-limit"
        "weekly-limit"
        "context-used"
        "context-window-size")
-}}
{{- $configPath := joinPath .chezmoi.destDir ".codex" "config.toml" -}}
{{- $existing := "" -}}
{{- $current := dict -}}
{{- if stat $configPath -}}
{{- $existing = include $configPath -}}
{{- $current = $existing | fromToml -}}
{{- range $key := list "mcp_servers" "apps" "plugins" "projects" "notice" "desktop" "features" -}}
{{- if hasKey $current $key -}}
{{- $_ := set $settings $key (index $current $key) -}}
{{- end -}}
{{- end -}}
{{- with index $current "tui" -}}
{{- $_ := mergeOverwrite $tui (pick . "model_availability_nux" "screen_reader_detection_done") -}}
{{- end -}}
{{- with index $current "hooks" -}}
{{- if hasKey . "state" -}}
{{- $_ := set $settings "hooks" (dict "state" (index . "state")) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $_ := set $settings "tui" $tui -}}
{{- if and $existing (eq (toJson $settings) (toJson $current)) -}}
{{ $existing -}}
{{- else -}}
# Personal Codex defaults managed by chezmoi.
# Connections, project trust, and client bookkeeping stay local to this machine.
{{ $settings | toToml }}
{{ end -}}
