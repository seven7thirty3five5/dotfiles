#!/bin/sh
#
# Install Homebrew in the folder the brew-prefix template names: its default
# folder with sudo, or a folder in your home without it (Linux only). On Linux
# with sudo, the system-packages script (10) has installed what it needs.

set -eu

prefix={{ includeTemplate "brew-prefix" . | trim | shellQuote }}
if [ -x "$prefix/bin/brew" ]; then
  exit 0
fi

# Saved first, so a failed download stops here rather than running nothing.
installer=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)

{{ if .useSudo -}}
# The installer asks no questions, so sudo must already have your password.
sudo -v
NONINTERACTIVE=1 /bin/bash -c "$installer" install.sh
{{- else -}}
# The installer refuses a folder whose path is longer than the default's.
HOMEBREW_NO_SUDO=1 NONINTERACTIVE=1 /bin/bash -c "$installer" install.sh --path "$prefix"
{{- end }}
