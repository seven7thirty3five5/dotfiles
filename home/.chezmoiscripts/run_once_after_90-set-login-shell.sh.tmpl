#!/bin/sh
#
# Make zsh your login shell: the shell a new terminal or SSH session starts.
#
# These dotfiles only configure zsh, and they use the system's own zsh: on
# macOS /bin/zsh, which has been the default login shell since macOS 10.15, and
# on Linux /usr/bin/zsh, which the install-system-packages script installs.
# Installing zsh also lists it in /etc/shells, the list of shells chsh accepts.
# chezmoi runs this once per machine ("run_once_"), after writing the dotfiles
# ("after_").
#
# Changing the login shell needs sudo, so this only does something where you
# answered yes to the setup question "Use sudo on this machine" (.useSudo).
# When the shell can't be changed (without sudo, or for an account that only an
# administrator can change, such as one from a company directory), the setup
# carries on, and install.sh lists that step at the end.

# Stop at the first command that fails (-e), and treat an unset variable as an
# error instead of quietly using an empty value (-u).
set -eu

{{ if not .useSudo -}}
# You answered no to "Use sudo on this machine": leave the login shell as it is.
exit 0
{{- else -}}
# The system's zsh; chezmoi keeps only this OS's line.
{{ if eq .chezmoi.os "darwin" -}}
zsh=/bin/zsh
{{- else -}}
zsh=/usr/bin/zsh
{{- end }}

# A login shell that can't start would lock you out of new terminals and SSH
# logins, so first check that this zsh starts: -f skips its startup files, and
# -c true runs a command that does nothing. (! -x: not a program we can run.)
if [ ! -x "$zsh" ] || ! "$zsh" -f -c true; then
  echo "error: $zsh is missing or doesn't start." >&2
  exit 1
fi

# Look up your current login shell; chezmoi keeps only this OS's line.
#   macOS: dscl reads the UserShell setting from the user directory.
#   Linux: getent prints your line from the user database; its 7th
#          colon-separated field (cut -d: -f7) is the login shell.
user=$(id -un)
{{ if eq .chezmoi.os "darwin" -}}
current=$(dscl . -read "/Users/$user" UserShell | awk '{print $2}')
{{- else -}}
current=$(getent passwd "$user" | cut -d: -f7)
{{- end }}

# Already the system's zsh? Then there's nothing to do.
if [ "$current" = "$zsh" ]; then
  exit 0
fi

# Change the login shell. sudo asks for your password if it doesn't remember
# it. On an account that only an administrator can change (one from a company
# directory, for example) chsh fails; `|| true` then carries on without an
# error, and install.sh lists the step at the end.
echo "Changing your login shell from $current to $zsh."
sudo chsh -s "$zsh" "$user" || true
{{- end }}
