#!/bin/sh
#
# Install LazyVim's plugins without opening Neovim.
#
# lazy-lock.json records the exact version of every plugin. When Neovim starts,
# lazy.nvim installs any missing plugin at that version, and `Lazy! restore`
# moves the installed ones to it. --headless runs Neovim without a window, and
# +qa quits when it's done.
#
# How chezmoi runs this file:
#   - "after_": after writing the dotfiles, which include Neovim's config.
#   - "run_onchange_": again whenever this file's text changes. The next two lines
#     hold fingerprints (hashes) of lazy-lock.json and lazyvim.json (the enabled
#     LazyVim extras), so a change to either makes chezmoi run this again.
# lazy-lock.json hash: {{ include "dot_config/nvim/.lazy-lock.json" | sha256sum }}
# lazyvim.json hash: {{ include "dot_config/nvim/lazyvim.json" | sha256sum }}

# Stop at the first command that fails (-e), and treat an unset variable as an
# error instead of quietly using an empty value (-u).
set -eu

# Find Homebrew; this sets $brew (see find-brew.sh in home/.chezmoitemplates).
{{ template "find-brew.sh" . }}

# Homebrew's nvim is in the same folder as brew: dirname turns .../bin/brew
# into .../bin.
"$(dirname "$brew")/nvim" --headless "+Lazy! restore" +qa
