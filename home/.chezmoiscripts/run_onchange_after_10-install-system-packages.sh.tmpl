{{- /*
  On Linux with sudo, install what Homebrew needs from the system's package
  manager (docs.brew.sh/Homebrew-on-Linux#requirements). Elsewhere this comes
  out empty and chezmoi skips it: macOS gets these from Apple's Command Line
  Tools, which Homebrew installs, and without sudo an administrator must.
*/ -}}

{{ if and (eq .chezmoi.os "linux") .useSudo -}}
#!/bin/sh
set -eu

if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y build-essential procps curl file git ca-certificates
elif command -v dnf >/dev/null 2>&1; then
  # The group is "development-tools" on newer Fedora, "Development Tools" on
  # older Fedora and RHEL. RHEL 9's curl-minimal conflicts with curl, and
  # --allowerasing swaps them, as dnf's own error suggests.
  sudo dnf group install -y development-tools || sudo dnf group install -y 'Development Tools'
  sudo dnf install -y --allowerasing procps-ng curl file git
elif command -v pacman >/dev/null 2>&1; then
  sudo pacman -S --needed --noconfirm base-devel procps-ng curl file git
else
  echo "warning: unknown package manager; install a C compiler, curl, file and git yourself." >&2
fi
{{ end -}}
