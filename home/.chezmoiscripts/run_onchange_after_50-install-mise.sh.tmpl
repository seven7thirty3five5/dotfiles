#!/bin/sh
#
# Install mise in ~/.local/bin, then the runtimes in its global config. It uses
# neither Homebrew nor sudo, so runtimes work even where Homebrew can't be
# installed. The config's hash below reruns this when the config changes.
# mise config: {{ include "dot_config/mise/config.toml" | sha256sum }}

set -eu

# Scripts don't get fish's XDG folders; without this one, mise's macOS cache
# would go in ~/Library/Caches.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

mise=$HOME/.local/bin/mise
if [ ! -x "$mise" ]; then
  # Saved first, so a failed download stops here rather than running nothing.
  installer=$(curl -fsSL https://mise.run)
  # MISE_INSTALL_HELP=0: fish's config already activates mise.
  MISE_INSTALL_PATH="$mise" MISE_INSTALL_HELP=0 sh -c "$installer"
fi

# From home, so a project's config can't change what's installed. `install`
# adds missing tools without rewriting the config, as `mise use -g` would.
cd "$HOME"
MISE_YES=1 "$mise" install
