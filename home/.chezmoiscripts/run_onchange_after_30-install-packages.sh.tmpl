#!/bin/sh
#
# Install what the Brewfile lists and isn't installed yet. chezmoi writes the
# Brewfile into this script, so editing the Brewfile changes the script and
# chezmoi runs it again (run_onchange_), as chezmoi's documentation does.

set -eu
{{- if not .useSudo }}

# No sudo on this machine: Homebrew, and the installers it runs, must never ask
# for a sudo password.
export HOMEBREW_NO_SUDO=1
{{- end }}

brew={{ includeTemplate "brew-prefix" . | trim | shellQuote }}/bin/brew
if [ ! -x "$brew" ]; then
  echo "error: Homebrew isn't installed, so the Brewfile's packages can't be." >&2
  exit 1
fi

eval "$("$brew" shellenv sh)"
brew bundle --file=- --no-upgrade <<'BREWFILE'
{{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . -}}
BREWFILE
