#!/bin/sh
#
# Install the global agent skills: instructions that coding agents load when a
# task needs them. The skills tool (skills.sh) puts each one in ~/.agents/skills,
# where Codex and other agents read it, and links it into ~/.claude/skills for
# Claude Code. Its record of what's installed, ~/.local/state/skills, stays on
# each machine; the update function updates the skills listed there.
#
# chezmoi runs this after writing the dotfiles and installing mise and pnpm
# ("after_", number 50 before this one), and again whenever this file changes
# ("run_onchange_"), for example when a skill is added below. A failed run is
# retried on the next apply.

# Stop at the first command that fails (-e), and treat an unset variable as an
# error instead of quietly using an empty value (-u).
set -eu

# install.sh runs under sh, which doesn't read fish's environment file. The
# skills tool keeps its record in $XDG_STATE_HOME, so give it the same folder.
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# -x: the file is executable. pnpm comes from mise (install-mise script, 50).
mise="$HOME/.local/bin/mise"
if [ ! -x "$mise" ]; then
  echo "error: mise not found, so pnpm, which installs the skills, is missing." >&2
  exit 1
fi

# Run from home so a project's config cannot change which pnpm or Node runs.
# `mise exec` puts mise's global pnpm and Node on PATH for one command. pnpm dlx
# downloads the skills tool and runs it without installing it. -g installs for
# the user, not a project; -a chooses the agents; --yes skips the questions.
cd "$HOME"
skills_add() {
  "$mise" exec -- pnpm dlx skills add "$@" \
    --global --agent claude-code codex --yes
}

# The global skills. Add a skill here and the next `chezmoi apply` installs it;
# `update` keeps every installed skill current. Each repository lists its skills
# with `pnpm dlx skills add <owner>/<repo> --list`.

# herdr's skill, for controlling herdr panes and agents.
skills_add herdrdev/herdr --skill herdr

# Every skill in Matt Pocock's repository, as `skills add mattpocock/skills`
# offers them. Use these instead of his plugin, which would give Claude each
# skill twice.
skills_add mattpocock/skills
