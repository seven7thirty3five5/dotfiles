#!/bin/sh
# Install Homebrew before chezmoi writes any file: the shell and git templates
# look for it.
#
# macOS  Homebrew goes in /opt/homebrew, which needs sudo the first time.
# Linux  With sudo: the default prefix, plus the build tools Homebrew needs.
#        Without sudo: ~/.linuxbrew or ~/.brew, whichever is no longer than the
#        default, so Homebrew can still use its prebuilt bottles.
set -eu

{{ template "find-brew.sh" . }}
if [ -n "$brew" ]; then
  exit 0 # already installed
fi

# Whether this user can run sudo; the checks from have_sudo_access() in
# Homebrew's own install.sh.
have_sudo() {
  [ -x /usr/bin/sudo ] || return 1

  if ! output=$(LC_ALL=C /usr/bin/sudo -n -k -l 2>&1); then
    case $output in
      *"is not in the sudoers file"*) return 1 ;;
      *"is not allowed to run sudo on"*) return 1 ;;
      *"may not run sudo on"*) return 1 ;;
      *'The "no new privileges" flag is set'*) return 1 ;;
      *"effective uid is not 0"*) return 1 ;;
      *"must be owned by uid 0 and have the setuid bit set"*) return 1 ;;
    esac
  fi

  if [ -t 0 ]; then
    # Ask for the password once; later sudo calls reuse it.
    /usr/bin/sudo -v && /usr/bin/sudo -l mkdir >/dev/null 2>&1
  else
    /usr/bin/sudo -n -l mkdir >/dev/null 2>&1
  fi
}

# Run Homebrew's official installer. Arguments, such as --path, are passed to it.
install_homebrew() {
  installer=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL "$installer")" install.sh "$@"
}

{{ if eq .chezmoi.os "darwin" -}}
# macOS ----------------------------------------------------------------------------

if [ "$(uname -m)" != arm64 ]; then
  echo "error: these dotfiles expect Homebrew in /opt/homebrew;" \
    "Intel Macs are not supported." >&2
  exit 1
fi

if ! have_sudo; then
  cat >&2 <<'MSG'
error: installing Homebrew on macOS requires sudo access for /opt/homebrew.
       Use an administrator account or ask an administrator to install Homebrew
       there, then re-run. Custom macOS prefixes are not supported by these dotfiles.
MSG
  exit 1
fi

install_homebrew
{{- else if eq .chezmoi.os "linux" -}}
# Linux ----------------------------------------------------------------------------

if have_sudo; then
  # Homebrew's requirements, plus zsh (the login shell) and unzip (for Mason).
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y build-essential procps curl file git ca-certificates zsh unzip
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf group install -y development-tools ||
      sudo dnf group install -y 'Development Tools'
    sudo dnf install -y procps-ng curl file git zsh unzip
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm base-devel procps-ng curl file git zsh unzip
  else
    echo "warning: unknown package manager;" \
      "install a C compiler, curl, file, git, zsh and unzip yourself." >&2
  fi

  install_homebrew
  exit 0
fi

# No sudo: install into the home folder. Homebrew only uses its prebuilt bottles
# in a custom prefix that is no longer than the default one.
default_prefix=/home/linuxbrew/.linuxbrew
prefix=
for candidate in "$HOME/.linuxbrew" "$HOME/.brew"; do
  if [ "${#candidate}" -le "${#default_prefix}" ]; then
    prefix=$candidate
    break
  fi
done

if [ -z "$prefix" ]; then
  echo "error: $HOME is too long for a Homebrew prefix that can use bottles" \
    "(${#default_prefix} bytes at most)." >&2
  echo "       Ask an administrator to create $default_prefix for you, then re-run." >&2
  exit 1
fi

missing=
for tool in curl git file cc zsh; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "warning: these need sudo to install, so ask an administrator:$missing" >&2
  echo "         (Homebrew itself needs curl and git)." >&2
fi

export HOMEBREW_NO_SUDO=1
install_homebrew --path "$prefix"
{{- end }}
