#!/bin/sh
#
# gh-dash is an extension for gh, GitHub's command-line tool, so gh installs
# it, not Homebrew. Using it needs `gh auth login`; installing it doesn't.

set -eu

gh={{ includeTemplate "brew-prefix" . | trim | shellQuote }}/bin/gh

# `gh extension list` shows nothing until you sign in, so check the folder.
if [ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/gh/extensions/gh-dash" ]; then
  "$gh" extension install dlvhdr/gh-dash
fi
