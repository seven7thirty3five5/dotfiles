{{- $prefixes := list "/home/linuxbrew/.linuxbrew" (joinPath .chezmoi.homeDir ".linuxbrew") -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $prefixes = list "/opt/homebrew" (joinPath .chezmoi.homeDir ".homebrew") -}}
{{- end -}}
{{- range $prefix := $prefixes -}}
{{- if isExecutable (joinPath $prefix "bin" "brew") -}}
{{- $prefix -}}
{{- break -}}
{{- end -}}
{{- end -}}
