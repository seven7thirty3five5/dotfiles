{{- /* Homebrew prefixes these dotfiles support, most preferred first, one per line.
       macOS uses only /opt/homebrew, which needs sudo to install. Without sudo,
       Linux uses a prefix in the home folder that is no longer than the default,
       so bottles still work (see the install-homebrew script). */ -}}
{{- if eq .chezmoi.os "darwin" -}}
/opt/homebrew
{{- else -}}
/home/linuxbrew/.linuxbrew
{{ joinPath .chezmoi.homeDir ".linuxbrew" }}
{{ joinPath .chezmoi.homeDir ".brew" }}
{{- end -}}
