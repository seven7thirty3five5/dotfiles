{{- /*
  chezmoi's settings on each machine, ~/.config/chezmoi/chezmoi.toml, written
  by `chezmoi init`. Each question is asked once per machine, and the answers
  are kept under [data], where the templates read them. To change an answer,
  edit it there.
*/ -}}

{{- $gitName := promptStringOnce . "gitName" "Git author name" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git author email (use your work email on work machines)" -}}
{{- $publish := promptBoolOnce . "publishDotfiles" "Commit and push dotfile changes from this machine" false -}}

{{- /*
  Macs always use sudo. A Linux machine, such as one at work, may not allow
  it: setup then never runs sudo there, and puts Homebrew in your home folder.
*/ -}}
{{- $useSudo := true -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $useSudo = promptBoolOnce . "useSudo" "Use sudo on this machine (no if you lack administrator rights)" false -}}
{{- end -}}

# Written by `chezmoi init` from home/.chezmoi.toml.tmpl in the dotfiles.

[add]
    # The repository is public: refuse to add files that look like secrets
    # (by default chezmoi only warns).
    secrets = "error"

[git]
    # Only the publishing machine commits and pushes chezmoi's changes.
    autoCommit = {{ $publish }}
    autoPush = {{ $publish }}

{{- if lookPath "delta" }}

# `chezmoi diff` through delta, once Homebrew has installed it. install.sh
# runs `chezmoi init` again at the end for this section and the next.
[diff]
    pager = "delta"
{{- end }}

{{- with lookPath "fish" }}

# `chezmoi cd` starts fish rather than the login shell, which has none of your
# setup. This is lookPath's full path, so it works from any shell.
[cd]
    command = {{ . | quote }}
{{- end }}

[data]
    gitName = {{ $gitName | quote }}
    gitEmail = {{ $gitEmail | quote }}
    publishDotfiles = {{ $publish }}
    useSudo = {{ $useSudo }}
