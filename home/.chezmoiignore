# Paths in your home folder that chezmoi leaves alone. This file is a template,
# so the lines between `if` and `end` apply only when the condition holds.

# Ghostty, and .hushlogin, which hides the "Last login" banner in each Ghostty
# tab, are macOS-only.
{{ if ne .chezmoi.os "darwin" }}
.config/ghostty
.hushlogin
{{ end }}

# Your login shell's startup files are yours: these dotfiles never write them.
.bash_login
.bash_logout
.bash_profile
.bashrc
.profile
.zlogin
.zlogout
.zprofile
.zshenv
.zshrc

# Machine-specific fish settings, which config.fish loads if they exist.
.config/fish/config-local.fish

# fish's own state: universal variables, and files it writes when upgrading.
.config/fish/fish_variables
.config/fish/conf.d/fish_frozen_*.fish

# The agents' settings and state stay on each machine, except the global
# instructions both read: Codex's AGENTS.md, and Claude Code's CLAUDE.md, a
# link to it. /* ignores what's inside each folder but not the folder itself,
# which is what lets the ! exceptions apply.
.claude/*
.codex/*
!.claude/CLAUDE.md
!.codex/AGENTS.md
