# Paths chezmoi leaves alone on this machine: it won't create or change them.
# Each line is a path in your home folder, written without the ~/.
#
# This file is a template. The lines between `if` and `end` below are only
# ignored when the condition is true: for example when this machine isn't a Mac
# (chezmoi calls macOS "darwin", and ne means "not equal").

# macOS-only: Ghostty's config, and .hushlogin, which hides the "Last login"
# banner login(1) prints in every Ghostty tab (Linux keeps its SSH login message).
{{ if ne .chezmoi.os "darwin" }}
.config/ghostty
.hushlogin
{{ end }}

# Your login shell's startup files are yours: these dotfiles never write them.
# The login shell only needs ~/.local/bin on PATH to start herdr (see the
# README's requirements).
.bash_login
.bash_logout
.bash_profile
.bashrc
.profile
.zlogin
.zlogout
.zprofile
.zshenv
.zshrc

# NEVER track machine-specific fish settings. config.fish loads this file, if
# it exists, for settings that only make sense on one machine.
.config/fish/config-local.fish

# fish's own saved state, which belongs to each machine: universal variables
# (set -U), and the files fish writes once when it upgrades an old setup.
.config/fish/fish_variables
.config/fish/conf.d/fish_frozen_*.fish

# Agent configuration and state belong to each machine, not the dotfiles: /*
# is everything directly inside the folder, and ignoring a folder ignores what
# it holds. (/** would ignore the folder itself too, and with it the files
# below.) The ! lines are exceptions, which win over every other line: the
# global instructions both agents read in every session, Codex's AGENTS.md and
# Claude Code's CLAUDE.md, a link to it.
.claude/*
.codex/*
!.claude/CLAUDE.md
!.codex/AGENTS.md
