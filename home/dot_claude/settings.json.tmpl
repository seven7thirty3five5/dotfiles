{{- /*
  Shared Claude Code settings. Hooks are left out: herdr installs its session
  hook here (`herdr integration install claude`), so keep whatever hooks this
  machine's settings already have. The settings are written between backticks
  and read as JSON, then written out again with this machine's hooks added.
  herdr also rewrites the file in its own formatting; when the contents already
  match, keep the file as it is, so chezmoi has nothing to change or ask about.
*/ -}}
{{- $settings := `
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    }
  },
  "fastMode": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "command": "jq -r '\n  def percentage:\n    if type == \"number\" then \"\\(floor)%\" else \"--\" end;\n  def capacity:\n    if . >= 1000000 then \"\\(. / 1000000)M\"\n    elif . >= 1000 then \"\\(. / 1000)k\"\n    else tostring end;\n\n  .context_window as $context |\n  \"Context \\($context.used_percentage | percentage)\" +\n  (if ($context.context_window_size | type) == \"number\"\n   then \" / \\($context.context_window_size | capacity)\"\n   else \"\" end) +\n  \" | 5h \\(.rate_limits.five_hour.used_percentage | percentage)\" +\n  \" | 7d \\(.rate_limits.seven_day.used_percentage | percentage)\"\n'",
    "type": "command"
  },
  "theme": "dark"
}
` | fromJson -}}
{{- $settingsPath := joinPath .chezmoi.destDir ".claude" "settings.json" -}}
{{- $existing := "" -}}
{{- if stat $settingsPath -}}
{{- $existing = include $settingsPath -}}
{{- $current := $existing | fromJson -}}
{{- if hasKey $current "hooks" -}}
{{- $_ := set $settings "hooks" (index $current "hooks") -}}
{{- end -}}
{{- if ne (toJson $settings) (toJson $current) -}}
{{- $existing = "" -}}
{{- end -}}
{{- end -}}
{{- if $existing -}}
{{ $existing -}}
{{- else -}}
{{ $settings | toPrettyJson -}}
{{- end -}}
