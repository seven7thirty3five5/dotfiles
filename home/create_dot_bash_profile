# shellcheck shell=bash
#
# ~/.bash_profile, written only on a Linux account that had no login file for
# bash at all (see .chezmoiignore); "create_" means chezmoi never replaces one
# that exists. A bash login shell, such as an SSH login, reads the first of
# ~/.bash_profile, ~/.bash_login and ~/.profile that exists, but never ~/.bashrc
# by itself. Like the files Linux systems give new accounts, this reads it.
# (-f: the file exists; . FILE runs FILE's commands in this shell. The line
# below the `if` tells ShellCheck not to look for ~/.bashrc while checking.)
if [ -f "$HOME/.bashrc" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.bashrc"
fi
