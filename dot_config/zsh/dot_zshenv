# Read by every zsh. Keep this file quiet and free of subprocesses.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CONFIG_DIRS="/etc/xdg"
export XDG_DATA_DIRS="/usr/local/share:/usr/share"
# XDG_RUNTIME_DIR is provided by the OS/session; do not invent a persistent path.
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Explicit overrides for tools whose macOS defaults may bypass XDG.
export BAT_CONFIG_DIR="$XDG_CONFIG_HOME/bat"
export EZA_CONFIG_DIR="$XDG_CONFIG_HOME/eza"
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
export _ZO_DATA_DIR="$XDG_DATA_HOME/zoxide"
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"

# Portable user binaries and the existing standalone pnpm installation.
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
typeset -U path
path=("$HOME/.local/bin" "$PNPM_HOME/bin" $path)
# Make Homebrew tools available to non-login shells, too.
if [[ $OSTYPE == darwin* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  elif [[ -x /usr/local/bin/brew ]]; then
    path=(/usr/local/bin /usr/local/sbin $path)
  fi
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  path=(/home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin $path)
fi
[[ -d "$HOME/.docker/bin" ]] && path+=("$HOME/.docker/bin")
export PATH
