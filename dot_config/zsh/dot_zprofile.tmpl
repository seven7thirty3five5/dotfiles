{{ if eq .chezmoi.os "darwin" -}}
{{- $brewPrefix := includeTemplate "brew-prefix" . | trim -}}
# /etc/zprofile has already run macOS path_helper.
{{ if $brewPrefix -}}
eval "$({{ joinPath $brewPrefix "bin" "brew" | shellQuote }} shellenv zsh)"
{{ end -}}
# Refresh the shared environment and editor selection after Homebrew setup.
[[ -f "$ZDOTDIR/env.zsh" ]] && source "$ZDOTDIR/env.zsh"
{{ else -}}
# Linux initializes Homebrew in interactive .zshrc instead.
{{ end -}}
