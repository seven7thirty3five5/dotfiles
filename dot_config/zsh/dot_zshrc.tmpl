{{- $brewPrefix := includeTemplate "brew-prefix" . | trim -}}
{{- $pluginPrefix := default "/usr" $brewPrefix -}}
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.functions" ]] && source "$HOME/.functions"

# Interactive setup only. Startup order is documented in the chezmoi README.
[[ -o interactive ]] || return

{{ if and (eq .chezmoi.os "linux") $brewPrefix -}}
# Homebrew shell initialization belongs to interactive shells on Linux.
eval "$({{ joinPath $brewPrefix "bin" "brew" | shellQuote }} shellenv zsh)"

{{ end -}}
# Shells that inherit ZDOTDIR skip the home bootstrap; reusing env.zsh is safe.
# Refresh editor selection after Homebrew setup as well.
[[ -f "$ZDOTDIR/env.zsh" ]] && source "$ZDOTDIR/env.zsh"

HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=10000
SAVEHIST=10000
mkdir -p -- "$XDG_STATE_HOME/zsh" "$XDG_CACHE_HOME/zsh"
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS

# Homebrew shellenv supplies its completions; add Docker's before compinit.
typeset -U fpath
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)
autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

# Use Emacs editing even when EDITOR or VISUAL is nvim/vim.
bindkey -e

# Atuin owns Ctrl-R; fzf keeps its default file/directory selection.
(( $+commands[fzf] )) && FZF_CTRL_R_COMMAND= source <(fzf --zsh)
(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh --cmd cd)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Default aliases and functions.
# Machine-specific customizations live in ~/.aliases and ~/.functions.
# Scope lazydocker's generic CONFIG_DIR variable to this one command.
(( $+commands[lazydocker] )) && lazydocker() { CONFIG_DIR="$XDG_CONFIG_HOME/lazydocker" command lazydocker "$@"; }

# Disable arrows at the zsh prompt after tools install their keybindings.
# Ctrl-F/B moves forward/backward; Ctrl-P/N moves through history.
zmodload zsh/terminfo
for _zsh_arrow in '\e[A' '\e[B' '\e[C' '\e[D' \
    '\eOA' '\eOB' '\eOC' '\eOD' \
    "${terminfo[kcuu1]}" "${terminfo[kcud1]}" "${terminfo[kcuf1]}" "${terminfo[kcub1]}"; do
  [[ -n "$_zsh_arrow" ]] && bindkey -M emacs "$_zsh_arrow" undefined-key
done
unset _zsh_arrow

# Homebrew on either OS, or standard Linux packages under /usr/share.
# Autosuggestions wraps widgets created above. Syntax highlighting goes last.
source {{ joinPath $pluginPrefix "share/zsh-autosuggestions/zsh-autosuggestions.zsh" | shellQuote }}
source {{ joinPath $pluginPrefix "share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" | shellQuote }}
